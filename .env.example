# Copy to .env and fill in. Never commit .env.
# NEXT_PUBLIC_* values are bundled into the browser: never put a secret in one.

# --- Supabase (dev project for Development and Preview, prod project for Production) ---
# Client + server. Public by design: RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Acts as service_role and skips RLS.
SUPABASE_SECRET_KEY=

# --- Clerk (auth and billing) ---
# Client.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Server only.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# --- OpenAI ---
# Server only.
OPENAI_API_KEY=

# --- Arcjet ---
# Server only.
ARCJET_KEY=

# --- PostHog ---
# Client + server.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- App ---
# Client + server.
NEXT_PUBLIC_APP_URL=
# Server only, read at request time. A public key, but per-environment config.
LANDING_WIDGET_KEY=
