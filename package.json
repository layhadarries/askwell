{
  "name": "askwell",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "pnpm build:widget && pnpm --filter web dev",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm build:widget && pnpm --filter web build",
    "build:widget": "pnpm --filter widget build && node -e \"const f=require('fs');f.mkdirSync('apps/web/public',{recursive:true});f.copyFileSync('apps/widget/dist/widget.js','apps/web/public/widget.js')\""
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  }
}
